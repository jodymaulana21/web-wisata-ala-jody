{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: buat venv & install dependency",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
      "windows": {
        "command": "python -m venv .venv; .venv\\Scripts\\pip install -r requirements.txt"
      },
      "problemMatcher": []
    },
    {
      "label": "Run: JelajahBot",
      "type": "shell",
      "command": ".venv/bin/streamlit run app.py",
      "windows": { "command": ".venv\\Scripts\\streamlit run app.py" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Test: pytest",
      "type": "shell",
      "command": ".venv/bin/pytest -v",
      "windows": { "command": ".venv\\Scripts\\pytest -v" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
