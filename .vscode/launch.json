{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Jalankan JelajahBot (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "🧪 Jalankan test (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "tests"],
      "justMyCode": true
    }
  ]
}
